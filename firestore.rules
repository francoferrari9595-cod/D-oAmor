rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }
    function isRoomMember(roomId) {
      return signedIn() && roomExists(roomId)
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.get('memberUids', []) is list
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.get('memberUids', []);
    }
    function isRoomGuest(roomId) {
      return signedIn() && roomExists(roomId)
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.get('guestUids', []) is list
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.get('guestUids', []);
    }
    function activeInviteForRoom(code, roomId) {
      return exists(/databases/$(database)/documents/guestInvites/$(code))
        && get(/databases/$(database)/documents/guestInvites/$(code)).data.get('active', false) == true
        && get(/databases/$(database)/documents/guestInvites/$(code)).data.get('roomId', '') == roomId;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invitaciones de vinculación: se conserva la lógica que usa la aplicación actual.
    match /invitations/{code} {
      allow read, write: if signedIn();
    }

    // Un código solo se puede crear/administrar desde una sala de la que el usuario es miembro.
    match /guestInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.get('roomId', '') is string
        && isRoomMember(request.resource.data.roomId)
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('active', false) == true;
      allow update: if signedIn()
        && isRoomMember(resource.data.get('roomId', ''))
        && request.resource.data.get('roomId', '') == resource.data.get('roomId', '')
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
      allow delete: if signedIn() && isRoomMember(resource.data.get('roomId', ''));
    }

    match /couples/{coupleId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn();
      allow delete: if false;
      match /{subcollection}/{document=**} {
        allow read, write: if signedIn();
      }
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.get('memberUids', []) is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids;
      allow get: if signedIn() && (isRoomMember(roomId) || isRoomGuest(roomId));
      allow list: if false;
      allow update: if isRoomMember(roomId)
        || (isRoomGuest(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'players']))
        || (signedIn()
          && request.resource.data.get('joinCode', '') is string
          && activeInviteForRoom(request.resource.data.joinCode, roomId)
          && request.resource.data.get('guestUids', []) is list
          && request.auth.uid in request.resource.data.guestUids
          && request.resource.data.guestUids.size() <= 2
          && request.resource.data.guestUids.hasAll(resource.data.get('guestUids', []))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUids', 'joinCode', 'players']));
      allow delete: if false;
    }
  }
}
