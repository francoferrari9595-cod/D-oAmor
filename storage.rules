rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/{allPaths=**} {
      // Solo integrantes de la pareja pueden acceder a sus medios. Limitar tamaño y
      // tipos reduce subidas accidentales o archivos arbitrarios.
      allow read: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberUids;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberUids &&
        request.resource != null && request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|audio/.*');
    }
  }
}
